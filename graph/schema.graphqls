scalar Time

type User {
  id: String!
  name: String!
  number: String!
  pin: String
  createdAt: Time
  updatedAt: Time
}
type Vender {
  id: String!
  name: String!
  number: String!
  pin: String
  product: [newProduct]
  isCompleted: Boolean
  createdAt: Time
  updatedAt: Time
}
type newProduct {
  id: String!
  name: String!
  price: String!
  state: String!
  title: String!
  brand: String!
  imageUrls: [String!]!
  venderId: String!
}
input ProductInput {
  name: String!
  price: String!
  state: ProductState!
  title: String!
  brand: String!
  imageUrls: [String!]!
  venderId: String!
}
enum ProductState {
  ACTIVE
  INACTIVE
}


type UserOrderProducts {
  id: String!
  user: User
  userId: String!
  product: [newProduct]
  quantity: String!
  isCompleted: Boolean
  createdAt: Time
  updatedAt: Time
}

type ProductRequest {
  id: String!
  user: User
  userId: String!
  Vender: Vender!
  VenderId: String!
  description: String
  imageUrls: [String]
  createdAt: Time!
  updatedAt: Time!
}
type systeminfor {
  bdtable: String!
  dbname: String!
}
input UserInput {
  name: String!
  number: String!
}

type Query {
  getUser: User!
  getAllUser: [User!]!
  getAllsysteminfor: systeminfor!
}

input NewUser {
  name: String!
  number: String!
}

type Mutation {
  createUser(input: NewUser!): User!
  createVender(input: NewUser!): Vender!
  createPorduct(input: ProductInput!): newProduct!

}
