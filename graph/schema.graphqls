scalar Time
scalar Upload

type User {
  id: String!
  name: String!
  number: String!
  pin: String
  createdAt: Time
  updatedAt: Time
}
type Vendor {
  id: String!
  name: String!
  number: String!
  pin: String
  product: [Product]
  isCompleted: Boolean
  createdAt: Time
  updatedAt: Time
}
type Product {
  id: String!
  name: String!
  price: String!
  state: String!
  title: String!
  brand: String!
  imageUrls: [String!]!
  Vendor: Vendor!
  vendorId: String!
  createdAt: Time!
  updatedAt: Time!
}
input ProductInput {
  name: String!
  price: String!
  state: ProductState!
  title: String!
  brand: String!
  imageUrls: [String!]!
  vendorId: String!
}
enum ProductState {
  ACTIVE
  INACTIVE
}

type UserOrder {
  id: String!
  user: User
  userId: String!
  product: [Product]
  quantity: String!
  isCompleted: Boolean
  createdAt: Time
  updatedAt: Time
}
input UserOrderInput {
  userId: String!
  productIds: [String!]!
  quantity: String!
  isCompleted: Boolean
}
type ProductRequest {
  id: String!
  user: User
  userId: String!
  Vendor: Vendor!
  VendorId: String!
  description: String
  imageUrls: [String]
  createdAt: Time!
  updatedAt: Time!
}
type systeminfor {
  bdtable: String!
  dbname: String!
}
input UserInput {
  name: String!
  number: String!
}

type Query {
  getUser: User!
  getAllUser: [User!]!
  getAllVendor: [Vendor!]!
  getAllProduct: [Product!]!
  userOrders: [UserOrder!]!
  getAllsysteminfor: systeminfor!
}

input NewUser {
  name: String!
  number: String!
}

type Mutation {
   singleUpload(file: Upload!): Boolean!
  createUser(input: NewUser!): User!
  delectUserById(id: String!): Boolean
  delectVendorById(id: String!): Boolean
  delectProductById(id: String!): Boolean
  createUserOrder(input: UserOrderInput!): UserOrder!
  delectTable: Boolean!
  createVendor(input: NewUser!): Vendor!
  createPorduct(input: ProductInput!): Product!
}
