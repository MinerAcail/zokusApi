type Vendor {
  id: String!
  name: String!
  type: String
  number: String!
  pin: String
  product: [Product]
  fileUrls: [FileUrl]
  profileUrl: String
  backgroundUrl: String
  isCompleted: Boolean
  createdAt: Time
  updatedAt: Time
}
type FavoriteVendor {
  id: String!
  userType: UserType!
  userId: String!
  vendor: Vendor!
  vendorId: String!
  createdAt: Time!
}
# union Returns = Vendor | User | SideSwapper

enum UserType {
  USER
  VENDOR
  SIDESWAPPER
}
type FavoriteVendorMateData {
  favoriteVendors: [FavoriteVendor!]!
  count: Int!
  mostFavoritedVendor: Vendor
}

extend type Query {
  getVendorById(id: String!): Vendor!
  getAllVendor: [Vendor!]!
  getAllProductByVendor: [Product!]!

  getUserFavoriteVendors: [Vendor!]!
  getTotalCountOfFavoriteVendor(vendorId: String!): Int!

  getAllFavoriteVendors: FavoriteVendorMateData!

  getProductforVPM:ProductforVPM
  getCartUsersByVendorId: [CartUser!]!
}
type CartUser {
  orderId: String!
  customer: String!
  date: String!
  status: String!
  totalAmount: String!
}
extend type Mutation {
  VendorUpload(files: [Upload], input: ProductInput): Product!
  delectVendorById(id: String!): Boolean
  createVendor(mateData: UploadVendorMateData, input: NewVendor!): Vendor!

  addFavoriteVendor(vendorId: String!): FavoriteVendor!
  removeFavoriteVendor(id: String!): Boolean
} 

input NewVendor {
  name: String!
  number: String!
  pin: String!
}

input UploadVendorMateData {
  profile: Upload
  background: Upload
}


type ProductforVPM {
  sideSwappers: String!
  personalDeliveryItems: String!
  zukoDeliveryItems: String!
  totalRevenue: String!
  totalProfit: String!
  totalProducts: String!
  lowStock: String
}
