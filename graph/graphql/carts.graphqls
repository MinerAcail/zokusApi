type CartItem {
  id: String!
  product: Product!
  productId: String!
  cartId: String!
  quantity: Int!
  createdAt: Time!
  updatedAt: Time!
}

type Cart {
  id: String!
  userType: UserType!
  userName: String! 
  UserNumber: String! 
  userId: String!
  items: [CartItem!]!
  createdAt: Time!
  updatedAt: Time!
}

extend type Query {
  getUserCart: Cart!
  getAllCart:[VendorOrder]!
  allCart:[Cart]!
}

extend type Mutation {
  addItemToCart(productId: String!, quantity: Int!): CartItem!
  decrementItemToCart(productId: String!): CartItem!

  
  removeItemFromCart(cartItemId: String!): Boolean!
  updateCartItem(cartItemId: String!, quantity: Int!): CartItem!
  clearCart: Boolean!
}




### for the vms

type VendorOrder {
  id: String!
  name: String!
  email: String!
  phone: String!
  status: String!
  orders: [Order!]!
  lastOrderDate: String!
  totalOrders: Int!
}

type Order {
  id: ID!
  customerId: ID!
  customerName: String!
  date: String!
  deliveryAddress: String!
  status: String!
  items: [OrderItem!]!
  paymentStatus: String!
  paymentMethod: String!
  shippingMethod: String!
  trackingNumber: String
  estimatedDeliveryDate: String!
}

type OrderItem {
  id: ID!
  name: String!
  quantity: Int!
  price: Float!
}



