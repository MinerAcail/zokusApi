type CartItem {
  id: String!
  product: Product!
  productId: String!
  cartId: String!
  quantity: Int!
  purchaseMetaData: PurchaseMetaData!
  orderId: String
  orderCartItemId: String
  deliveryStatus: DeliveryStatus!
  deliveryMetaData: DeliveryMetaData!
  createdAt: Time!
  updatedAt: Time!
}

type CartItemGroup {
  id: String!
  groupLabel: String!
  items: [Group!]!

  createdAt: Time!
  updatedAt: Time!
}

type Group {
  id: String!
  cartItem: CartItem!
  cartItemId: String!
  quantityGroup: Int!
  cartItemGroup: CartItemGroup!
  cartItemGroupID: String!
  orderItemsID: String
  createdAt: Time!
  updatedAt: Time!
}

type Order {
  id: String!
  customerId: String!
  customerName: String!
  date: String!
  deliveryAddress: String!
  status: String!
  # items: [CartItem!]!
  # orderItems: [Group!]!
orderItems:[Group!]!
orderItemsID:[String!]!
  paymentStatus: String!
  paymentMethod: String!
  shippingMethod: String!
  trackingNumber: String
  estimatedDeliveryDate: String!
  createdAt: Time!
  updatedAt: Time!
}

type PurchaseMetaData {
  id: String!
  status: String!
  cartItemId: String!
  cartId: String!
  createdAt: Time!
  updatedAt: Time!
}

type DeliveryStatus {
  id: String!
  status: String!
  cartItemId: String!
  description: String!
  createdAt: Time!
  updatedAt: Time!
}

type Cart {
  id: String!
  userType: UserType!
  userName: String!
  UserNumber: String!
  userId: String!
  purchaseMetaData: [PurchaseMetaData!]!
  items: [CartItem!]!
  location: [DeliveryMetaData]!

  createdAt: Time!
  updatedAt: Time!
}

type DeliveryMetaData {
  id: String!
  locationName: String!
  momoNumber: String!
  cartItemId: String!
  orderId: String!
  latitude: String!
  longitude: String!
  cartId: String!
  createdAt: Time!
  updatedAt: Time!
}
type Category {
  groupLabel: String!
  groupLabelId: String!
  quantityForAGroupLabel: Int!
}
type OrderData {
  infor: Order!
  orderItems: [Group!]!
}
extend type Query {
  getUserCart: Cart!
  getUserCartMetaData: [PurchaseMetaData!]!
  getUserCartWithMetaData: [CartItem!]!
  purchaseHistory: [PurchaseHistory!]!
  getAllCart: [VendorOrder]!
  allCart: [Cart]!
  getOrder(orderItemsID: String!): OrderData!
  getAllOrder: [OrderData!]!  
  getAllCategoriesLabelsByUser: [Category!]!
  getgroupLabel(label: String!): CartItemGroup!
  getAllgroupLabel: [CartItemGroup!]!
}
input groupInput {  
  groupLabel: String!
  cartItemId: String!
  quantityGroup: Int!
}
extend type Mutation {
  addItemToCart(productId: String!, quantity: Int!): CartItem!
  CleanUpAddItemToCart(cartItemId: String!): String!
  addItemToCartGroupLabel(cartItemId: String!): CartItem!
  addCategory(
    groupLabel: String!
    quantityForAGroupLabel: Int!
    cartItemId: String!
  ): CartItemGroup!
  addGroupLabel(input: groupInput!): CartItemGroup!

  createOrder(input: CreateOrderInput!): Order!
  decrementItemToCart(productId: String!): CartItem!
  addDeliveryMetaData(
    locationName: String!
    momoNumber: String!
  ): DeliveryMetaData!
  removeItemFromCart(cartItemId: String!): Boolean!
  updateCartItem(cartItemId: String!, quantity: Int!): CartItem!
  clearCart: Boolean!
}

### for the vms

type VendorOrder {
  id: String!
  name: String!
  email: String!
  phone: String!
  status: String!
  orders: [Order!]!
  lastOrderDate: String!
  totalOrders: Int!
}

input CreateOrderInput {
  deliveryAddress: String!
  cartItemId: [String!]!
}

type OrderItem {
  id: String!
  name: String!
  quantity: Int!
  price: Float!
}

type PurchaseHistoryItem {
  id: String!
  name: String!
  price: String!
  quantity: String!
  imageUrl: String!
}

# PurchaseHistory represents the complete purchaseHistory with a list of items
type PurchaseHistory {
  id: String!
  date: String!
  items: [PurchaseHistoryItem!]!
  status: String!
  trackingNumber: String
}
