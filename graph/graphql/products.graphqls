type Product {
  id: String
  name: String
  price: String
  state: String
  title: String
  brand: String
  imageUrls: [String]
  vendorsBucketName: String
  Vendor: Vendor
  vendorId: String
  createdAt: Time
  updatedAt: Time
}

input ProductInput {
  name: String!
  price: String!
  state: ProductState!
  title: String!
  brand: String!
}
enum ProductState {
  ACTIVE
  INACTIVE
}

type ProductRequest {
  id: String!
  user: User
  userId: String!
  Vendor: Vendor!
  VendorId: String!
  description: String
  imageUrls: [String]
  createdAt: Time!
  updatedAt: Time!
}

type FavoriteProduct {
  id: String!
userType: UserType!
  userId: String!
  product: Product!
  productId: String!
  createdAt: Time!
}
type FavoriteMateData {
  favoriteProducts: [FavoriteProduct!]!
  count: Int!
  totalPrice: Float
  mostFavoritedProduct: Product
}

extend type Query {
  getAllProduct: [Product!]!
  getUserFavoriteProducts: [Product!]!
  getFavoriteProduct(id: String!): FavoriteProduct
  getAllFavoriteProduct(Vendorid: String!): FavoriteMateData!
}

extend type Mutation {
  delectProductById(id: String!): Boolean
  createPorduct(input: ProductInput!): Product!
  addFavoriteProduct(productId: String!): FavoriteProduct!
  removeFavoriteProduct(id: String!): Boolean
}
